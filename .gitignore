.claude/settings.local.json

# Per-developer Claude notes
CLAUDE.local.md

# CodeGraph data — rebuilt locally; only config.json is shared.
# (.codegraph/.gitignore already handles this, but mirror it here so anyone
# without codegraph installed still gitignores it.)
.codegraph/*.db
.codegraph/*.db-wal
.codegraph/*.db-shm
.codegraph/cache/
.codegraph/*.log
.codegraph/.dirty

